# 复制本文件为 .env 并填入真实值（.env 不会进仓库）
DB_PASSWORD=你的MySQL密码
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_NAME=mqtt_data

# 短信：dryrun=只打日志不发（默认）；aliyun=真实发送（需下面四个配置）
SMS_PROVIDER=dryrun
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=

# 检测器
# DETECTOR_POLL_SECONDS=10
# DETECTOR_OFFLINE_SECONDS=780
